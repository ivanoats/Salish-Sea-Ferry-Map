{
  "name": "salish-sea-ferry-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive map of every ferry route across the Salish Sea — Puget Sound, the Strait of Georgia, and the Strait of Juan de Fuca — spanning Washington State Ferries, BC Ferries, Black Ball Ferry Line, Kitsap Transit, Victoria Clipper, Puget Sound Express, and regional county and community ferries.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run maplibre-worker && panda codegen --silent && next dev",
    "build": "npm run maplibre-worker && panda codegen --silent && next build",
    "build-route-geometry": "node scripts/build-route-geometry.ts",
    "start": "next start",
    "maplibre-worker": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "lint": "eslint .",
    "typecheck": "panda codegen --silent && tsc --noEmit",
    "test": "panda codegen --silent && vitest run",
    "test:watch": "panda codegen --silent && vitest",
    "favicons": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.38.1",
    "maplibre-gl": "^6.3.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "@park-ui/panda-preset": "^0.43.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@park-ui/panda-preset@0.43.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "postcss": "^8.5.23",
    "browserslist": "^4.28.7",
    "postcss-selector-parser": "^7.1.3",
    "effect": "^3.20.0",
    "@ark-ui/anatomy": {
      "@zag-js/core": "^0.82.2"
    },
    "@zag-js/time-picker": {
      "@zag-js/core": "^0.82.2"
    }
  }
}
