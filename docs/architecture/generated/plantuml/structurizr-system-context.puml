@startuml
title <size:24>System Context View: Salish Sea Ferry Map</size>\n<size:24>System context</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

AddElementTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("External", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

Person(Mapuser, "Map user", $descr="Browses and filters ferry routes.", $tags="Element", $link="")
Person(Maintainer, "Maintainer", $descr="Curates operators, terminals, routes, and geometry inputs.", $tags="Element", $link="")
System(OpenStreetMap, "OpenStreetMap", $descr="Raster tiles for the basemap.", $tags="External", $link="")
System(WSDOTVesselLocationsAPI, "WSDOT Vessel Locations API", $descr="Optional live vessel positions.", $tags="External", $link="")
System(SalishSeaFerryMap, "Salish Sea Ferry Map", $descr="Interactive route map spanning multiple ferry operators.", $tags="Element", $link="")

Rel(Mapuser, SalishSeaFerryMap, "Requests pages", $techn="", $tags="Relationship", $link="")
Rel(Maintainer, SalishSeaFerryMap, "Curates operators, terminals, routes, and geometry", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap, WSDOTVesselLocationsAPI, "Vessel locations", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap, OpenStreetMap, "Basemap tiles", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml