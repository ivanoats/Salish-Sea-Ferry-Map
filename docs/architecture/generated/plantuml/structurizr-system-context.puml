@startuml
title <size:24>System Context View: Salish Sea Ferry Map</size>\n<size:24>System context</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

Person(Mapuser, "Map user", $descr="Browses and filters ferry routes.", $tags="", $link="")
Person(Maintainer, "Maintainer", $descr="Curates operators, terminals, routes, and geometry inputs.", $tags="", $link="")
System(OpenStreetMap, "OpenStreetMap", $descr="Raster tiles for the basemap.", $tags="", $link="")
System(WSDOTVesselLocationsAPI, "WSDOT Vessel Locations API", $descr="Optional live vessel positions.", $tags="", $link="")
System(SalishSeaFerryMap, "Salish Sea Ferry Map", $descr="Interactive route map spanning multiple ferry operators.", $tags="", $link="")

Rel(Mapuser, SalishSeaFerryMap, "Browses routes, terminals, and optional live vessels", $techn="", $tags="", $link="")
Rel(Maintainer, SalishSeaFerryMap, "Updates the static dataset and generated geometry", $techn="", $tags="", $link="")
Rel(SalishSeaFerryMap, OpenStreetMap, "Uses raster map tiles at runtime", $techn="", $tags="", $link="")
Rel(SalishSeaFerryMap, WSDOTVesselLocationsAPI, "Fetches optional live vessel data through a server-side proxy", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml