@startuml
title <size:24>Component View: Salish Sea Ferry Map - Live vessel proxy</size>\n<size:24>Component view — live vessel proxy</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("External", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $shadowing="", $borderStyle="solid")

System(WSDOTVesselLocationsAPI, "WSDOT Vessel Locations API", $descr="Optional live vessel positions.", $tags="External", $link="")

System_Boundary("SalishSeaFerryMap_boundary", "Salish Sea Ferry Map", $tags="Element") {
  Container_Boundary("SalishSeaFerryMap.Livevesselproxy_boundary", "Live vessel proxy", $tags="Element") {
    Component(SalishSeaFerryMap.Livevesselproxy.Vesselproxyroute, "Vessel proxy route", $techn="src/app/api/vessels/route.ts", $descr="Server-side WSDOT call that keeps the API key off the client and parses the response.", $tags="Element", $link="")
  }

  Container(SalishSeaFerryMap.BrowsermapUI, "Browser map UI", $techn="MapLibre GL JS, React", $descr="Renders routes, terminals, filters, and optional vessels over the basemap.", $tags="Element", $link="")
  Container(SalishSeaFerryMap.Nextjswebapp, "Next.js web app", $techn="Next.js App Router, React, TypeScript", $descr="Serves the site and bundles the shared application modules.", $tags="Element", $link="")
}

Rel(SalishSeaFerryMap.Nextjswebapp, SalishSeaFerryMap.BrowsermapUI, "Delivers to the browser", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.Livevesselproxy.Vesselproxyroute, SalishSeaFerryMap.Nextjswebapp, "Parses payloads", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.Livevesselproxy.Vesselproxyroute, WSDOTVesselLocationsAPI, "Vessel locations", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI, SalishSeaFerryMap.Nextjswebapp, "Operators, routes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI, SalishSeaFerryMap.Livevesselproxy.Vesselproxyroute, "GET /api/vessels", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml