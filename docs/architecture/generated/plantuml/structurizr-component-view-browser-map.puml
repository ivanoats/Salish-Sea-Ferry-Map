@startuml
title <size:24>Component View: Salish Sea Ferry Map - Browser map UI</size>\n<size:24>Component view — browser map UI</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("External", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $shadowing="", $borderStyle="solid")

Person(Mapuser, "Map user", $descr="Browses and filters ferry routes.", $tags="Element", $link="")

System(OpenStreetMap, "OpenStreetMap", $descr="Raster tiles for the basemap.", $tags="External", $link="")

System_Boundary("SalishSeaFerryMap_boundary", "Salish Sea Ferry Map", $tags="Element") {
  Container_Boundary("SalishSeaFerryMap.BrowsermapUI_boundary", "Browser map UI", $tags="Element") {
    Component(SalishSeaFerryMap.BrowsermapUI.Appshell, "App shell", $techn="src/components/layout/app-shell.tsx", $descr="Owns operator filter state and wires the panel to the map.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowsermapUI.Operatorfilter, "Operator filter", $techn="src/components/panels/operator-filter.tsx", $descr="Ark UI checkboxes for per-operator visibility.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowsermapUI.Ferrymap, "Ferry map", $techn="src/components/map/ferry-map.tsx", $descr="MapLibre GL map, layers, and interactions.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowsermapUI.Vesselpositionshook, "Vessel positions hook", $techn="src/components/map/use-vessel-positions.ts", $descr="Polls the proxy for live WSF vessels.", $tags="Element", $link="")
  }

  Container(SalishSeaFerryMap.Livevesselproxy, "Live vessel proxy", $techn="Next.js route handler, TypeScript", $descr="Fetches WSDOT vessel positions without exposing the API key to the browser.", $tags="Element", $link="")
  Container(SalishSeaFerryMap.Nextjswebapp, "Next.js web app", $techn="Next.js App Router, React, TypeScript", $descr="Serves the site and bundles the shared application modules.", $tags="Element", $link="")
}

Rel(Mapuser, SalishSeaFerryMap.Nextjswebapp, "Requests pages", $techn="", $tags="Relationship", $link="")
Rel(Mapuser, SalishSeaFerryMap.BrowsermapUI.Appshell, "Views and filters ferry routes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.Nextjswebapp, SalishSeaFerryMap.BrowsermapUI.Appshell, "Delivers to the browser", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.Livevesselproxy, SalishSeaFerryMap.Nextjswebapp, "Parses payloads", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI.Appshell, SalishSeaFerryMap.BrowsermapUI.Operatorfilter, "Filter state", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI.Appshell, SalishSeaFerryMap.BrowsermapUI.Ferrymap, "Visible routes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI.Appshell, SalishSeaFerryMap.BrowsermapUI.Vesselpositionshook, "Live vessels", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI.Appshell, SalishSeaFerryMap.Nextjswebapp, "Operators, routes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI.Ferrymap, SalishSeaFerryMap.Nextjswebapp, "Feature collections", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI.Ferrymap, OpenStreetMap, "Basemap tiles", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowsermapUI.Vesselpositionshook, SalishSeaFerryMap.Livevesselproxy, "GET /api/vessels", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml