@startuml
title <size:24>Component View: Salish Sea Ferry Map - Browser UI</size>\n<size:24>Component view — browser UI</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("External", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Element", $bgColor="#ffffff", $borderColor="#444444", $fontColor="#444444", $shadowing="", $borderStyle="solid")

Person(Mapuser, "Map user", $descr="Browses and filters ferry routes.", $tags="Element", $link="")

System(OpenStreetMap, "OpenStreetMap", $descr="Raster tiles for the basemap.", $tags="External", $link="")
System(OpenFreeMap, "OpenFreeMap", $descr="Hosted no-key basemap styles and vector tiles.", $tags="External", $link="")
System(VersaTiles, "VersaTiles", $descr="Hosted no-key basemap style and vector tiles.", $tags="External", $link="")
System(StadiaMaps, "Stadia Maps", $descr="Stamen Terrain raster tiles; keyless on registered domains, optional public key otherwise.", $tags="External", $link="")

System_Boundary("SalishSeaFerryMap_boundary", "Salish Sea Ferry Map", $tags="Element") {
  Container_Boundary("SalishSeaFerryMap.BrowserUI_boundary", "Browser UI", $tags="Element") {
    Component(SalishSeaFerryMap.BrowserUI.Mapshell, "Map shell", $techn="src/components/layout/app-shell.tsx", $descr="Wires the sidebar, basemap selector, and vessel toggle to the map.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowserUI.Sharedsidebar, "Shared sidebar", $techn="src/components/layout/sidebar.tsx", $descr="Brand, Map / Route diagram switch, and per-page route filter state.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowserUI.Operatorfilter, "Operator filter", $techn="src/components/panels/operator-filter.tsx", $descr="Ark UI checkboxes for per-operator visibility.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowserUI.Ferrymap, "Ferry map", $techn="src/components/map/ferry-map.tsx", $descr="MapLibre GL map, layers, basemaps, and interactions.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowserUI.Vesselpositionshook, "Vessel positions hook", $techn="src/components/map/use-vessel-positions.ts", $descr="Polls the proxy for live WSF vessels.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowserUI.Routediagramshell, "Route diagram shell", $techn="src/components/schematic/schematic-shell.tsx", $descr="Wires the sidebar to the diagram.", $tags="Element", $link="")
    Component(SalishSeaFerryMap.BrowserUI.Routediagram, "Route diagram", $techn="src/components/schematic/", $descr="Plain-SVG octolinear diagram, legend, and False Creek inset.", $tags="Element", $link="")
  }

  Container(SalishSeaFerryMap.Livevesselproxy, "Live vessel proxy", $techn="Next.js route handler, TypeScript", $descr="Fetches WSDOT vessel positions without exposing the API key to the browser.", $tags="Element", $link="")
  Container(SalishSeaFerryMap.Nextjswebapp, "Next.js web app", $techn="Next.js App Router, React, TypeScript", $descr="Serves the site and bundles the shared application modules.", $tags="Element", $link="")
}

Rel(Mapuser, SalishSeaFerryMap.Nextjswebapp, "Requests pages", $techn="", $tags="Relationship", $link="")
Rel(Mapuser, SalishSeaFerryMap.BrowserUI.Mapshell, "Views and filters ferry routes", $techn="", $tags="Relationship", $link="")
Rel(Mapuser, SalishSeaFerryMap.BrowserUI.Routediagramshell, "Reads the route diagram", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.Nextjswebapp, SalishSeaFerryMap.BrowserUI.Mapshell, "Delivers / to the browser", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.Nextjswebapp, SalishSeaFerryMap.BrowserUI.Routediagramshell, "Delivers /schematic to the browser", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.Livevesselproxy, SalishSeaFerryMap.Nextjswebapp, "Parses payloads", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Mapshell, SalishSeaFerryMap.BrowserUI.Sharedsidebar, "Filter state", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Mapshell, SalishSeaFerryMap.BrowserUI.Ferrymap, "Visible routes, basemap", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Mapshell, SalishSeaFerryMap.BrowserUI.Vesselpositionshook, "Live vessels", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Routediagramshell, SalishSeaFerryMap.BrowserUI.Sharedsidebar, "Filter state", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Routediagramshell, SalishSeaFerryMap.BrowserUI.Routediagram, "Visible routes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Sharedsidebar, SalishSeaFerryMap.BrowserUI.Operatorfilter, "Operator checkboxes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Sharedsidebar, SalishSeaFerryMap.Nextjswebapp, "Operators, routes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Routediagram, SalishSeaFerryMap.Nextjswebapp, "Diagram paths and lanes", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Ferrymap, SalishSeaFerryMap.Nextjswebapp, "Feature collections", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Ferrymap, OpenStreetMap, "Basemap tiles", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Ferrymap, OpenFreeMap, "Basemap styles and tiles", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Ferrymap, VersaTiles, "Basemap styles and tiles", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Ferrymap, StadiaMaps, "Basemap tiles", $techn="", $tags="Relationship", $link="")
Rel(SalishSeaFerryMap.BrowserUI.Vesselpositionshook, SalishSeaFerryMap.Livevesselproxy, "GET /api/vessels", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml