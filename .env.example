# Free WSDOT Traveler API access code — request one at
# https://wsdot.wa.gov/traffic/api/ and put it in .env.local (not this file).
# Without it, the "WSF vessel positions (beta)" toggle in the app just shows
# a note that live data isn't configured; everything else works fine.
WSF_API_KEY=

# Stamen Terrain basemap. Public browser key; keep the real value in .env.local.
# Optional for localhost or domains registered with Stadia Maps.
# Restart development / rebuild deployment after changing this value.
NEXT_PUBLIC_STADIA_MAPS_API_KEY=
